-- 17 Найди самый дорогой товар (без ORDER BY + LIMIT — через подзапрос с MAX)
SELECT *
FROM products
WHERE products.price = (SELECT MAX(products.price)
                        FROM products)

-- 18 Найди товары, дороже средней цены по своей категории (коррелированный подзапрос)
SELECT *
FROM products
         JOIN categories ON products.category_id = categories.id
WHERE price > (SELECT AVG(p.price)
               FROM products p
               WHERE products.category_id = p.category_id)

-- 19 Выведи клиентов, чей суммарный объём покупок больше среднего суммарного объёма по всем клиентам
SELECT customers.full_name, SUM(order_items.quantity * order_items.unit_price)
      FROM customers
      JOIN orders ON customers.id = orders.customer_id
      JOIN order_items ON orders.id = order_items.order_id
GROUP BY customers.id, customers.full_name
HAVING SUM(order_items.quantity * order_items.unit_price) > (SELECT AVG(custtomers_total1)
                                                             FROM (
                                                                 SELECT SUM(order_items.quantity * order_items.unit_price) as custtomers_total1
                                                                 FROM orders
                                                                 JOIN order_items ON orders.id = order_items.order_id
                                                                 GROUP BY orders.id
                                                                  ))

-- 21 Выведи последний заказ каждого клиента (подзапрос с MAX(created_at)).
SELECT *
FROM customers
JOIN orders o ON customers.id = o.customer_id
WHERE o.created_at = (SELECT MAX(or1.created_at)
                           FROM orders or1
