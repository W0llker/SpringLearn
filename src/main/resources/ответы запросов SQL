-- 1.Выведи все товары вместе с названием их категории (INNER JOIN).
SELECT products.name, categories.name
FROM products LEFT JOIN categories ON products.category_id = categories.id

-- 2.Выведи все заказы: id заказа, имя клиента, статус, дата.
SELECT orders.id, customers.full_name, orders.status, orders.created_at
FROM orders JOIN customers ON orders.customer_id = customers.id

-- 3.Выведи ВСЕ товары, даже те, у которых категория не указана, вместе с категорией (LEFT JOIN)
SELECT products.id, products.name, products.price, categories.name
FROM products LEFT JOIN categories ON products.category_id = categories.id

-- 4.Найди товары, которые ещё ни разу не покупали (JOIN + условие IS NULL).
SELECT products.name
FROM products LEFT JOIN order_items as ord ON ord.product_id = products.id
WHERE ord.product_id  IS NULL

-- 5.Выведи клиентов, у которых нет ни одного заказа (LEFT JOIN + IS NULL).
SELECT customers.full_name
FROM customers LEFT JOIN orders ON customers.id = orders.customer_id
WHERE orders.customer_id is null

-- 6.Для каждой позиции заказа покажи: id заказа, имя клиента, название товара, количество, цену позиции (quantity × unit_price)
SELECT order_items.id, customers.full_name,products.name, products.stock, (order_items.quantity * order_items.unit_price)
FROM order_items JOIN orders ON order_items.order_id = orders.id
JOIN customers ON orders.customer_id = customers.id
JOIN products ON order_items.product_id = products.id

-- 7.Выведи заказы, где есть товар из категории «Книги» (три таблицы: orders → order_items → products → categories).
SELECT orders.*
FROM orders JOIN order_items ON orders.id = order_items.order_id
JOIN products ON order_items.product_id = products.id
JOIN categories ON products.category_id = categories.id
WHERE categories.name = 'Книги'

